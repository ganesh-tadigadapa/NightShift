{
  "name": "nightshift",
  "version": "1.0.0",
  "private": true,
  "description": "NightShift \u2014 automatic, readable dark themes for every website.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run build && cd dist && zip -qr ../nightshift.zip . && echo 'NightShift: nightshift.zip ready'"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  }
}
